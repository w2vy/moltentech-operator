#!/bin/bash
# burn-run — the half of fh-burner that runs INSIDE each burn VM.
#
#   burn-run <phase> <start-epoch> [arg]
#
# The host controller (burn-host.sh) calls this through the qemu-guest-agent socket,
# so the VM needs no network. Every VM is handed the same <start-epoch>; each one
# sleeps until then, so a phase starts on all VMs within milliseconds (kvm-clock is
# shared with the host). Prints one JSON line.
#
# Phases:
#   mem [pct|max]   touch and HOLD memory, then return. Default `max` = the guest's
#                   MemAvailable less 100 MB, which is where a real node's page cache
#                   ends up. Each page gets random bytes so KSM cannot merge them —
#                   burn measures the host with KSM giving nothing back (worst case).
#   memfree         release what `mem` holds.
#   eps [secs]      sysbench cpu at Flux's settings (--cpu-max-prime=60000) on every
#                   vCPU. Compared as a drop from the 1-VM run, not against Flux floors.
#   dd [MB]         direct-I/O sequential write, MB/s. Same: a relative number.
#   version         the image version.
set -uo pipefail
phase=${1:-version}; start=${2:-0}; arg=${3:-}

d=$(awk -v s="$start" -v n="$(date +%s.%N)" 'BEGIN{print s-n}')
awk -v d="$d" 'BEGIN{exit !(d>0)}' && sleep "$d"
t0=$(date +%s.%N)
lag() { awk -v a="$t0" -v s="$start" 'BEGIN{printf "%.3f", (s>0 ? a-s : 0)}'; }

case $phase in
  mem)
    fill=${arg:-max}
    rm -f /run/burn-mem-ready
    nohup python3 -c "
import os, time
mi = {l.split(':')[0]: int(l.split()[1]) for l in open('/proc/meminfo')}
fill = '$fill'
n = (mi['MemAvailable'] - 102400) * 1024 if fill == 'max' else mi['MemTotal'] * 1024 * int(fill) // 100
b = bytearray(n)
r = os.urandom(8 * (n // 4096 + 1))
for i in range(0, n, 4096):
    b[i:i+8] = r[i//512:i//512+8]
open('/run/burn-mem-ready', 'w').write(str(n))
time.sleep(1e9)" >/dev/null 2>&1 &
    for _ in $(seq 600); do [ -f /run/burn-mem-ready ] && break; sleep 1; done
    secs=$(awk -v a="$t0" -v b="$(date +%s.%N)" 'BEGIN{printf "%.1f", b-a}')
    echo "{\"phase\":\"mem\",\"fill\":\"$fill\",\"bytes\":$(cat /run/burn-mem-ready 2>/dev/null || echo 0),\"secs\":$secs}" ;;
  memfree)
    pkill -f burn-mem-ready; rm -f /run/burn-mem-ready
    echo '{"phase":"memfree"}' ;;
  eps)
    th=$(nproc)
    e=$(sysbench cpu --cpu-max-prime=60000 --threads="$th" --time="${arg:-30}" run | awk '/events per second/{print $4}')
    echo "{\"phase\":\"eps\",\"threads\":$th,\"eps\":${e:-0},\"start_lag\":$(lag)}" ;;
  dd)
    f=/var/tmp/burn-dd; mb=${arg:-2048}
    out=$(dd if=/dev/zero of=$f bs=1M count="$mb" oflag=direct conv=fsync 2>&1 | tail -1); rm -f $f
    # "2147483648 bytes (2.1 GB, 2.0 GiB) copied, 5.1 s, 421 MB/s" → "421 MB/s"
    rate=$(echo "$out" | awk -F', ' '{print $NF}')
    echo "{\"phase\":\"dd\",\"mb\":$mb,\"rate\":\"$rate\",\"start_lag\":$(lag)}" ;;
  version)
    echo "{\"phase\":\"version\",\"version\":\"$(cat /etc/fh-burner-version 2>/dev/null || echo unknown)\"}" ;;
  *)
    echo "{\"error\":\"unknown phase $phase\"}"; exit 2 ;;
esac
